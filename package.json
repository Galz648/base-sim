{
  "name": "base-sim",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "scene-tree": "file:./scene-tree",
    "typescript": "~5.9.3",
    "typescript-to-gdscript": "^0.1.11"
  },
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "postinstall": "mkdir -p node_modules && touch node_modules/.gdignore",
    "convert": "tstogd convert",
    "watch": "tstogd watch",
    "convert:examples": "cd examples && tstogd convert",
    "watch:examples": "cd examples && tstogd watch",
    "convert:sketches": "cd sketches && tstogd convert",
    "watch:sketches": "cd sketches && tstogd watch",
    "scene-tree": "npm run compile --prefix scene-tree"
  },
  "trustedDependencies": [
    "tree-sitter-gdscript",
    "tree-sitter-godot-resource"
  ]
}
